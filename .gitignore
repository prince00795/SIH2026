# ==============================================================================
# VayuSutra APIx - Git Ignore Configuration
# Prevents large binary files, caches, and logs from exceeding GitHub limits
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and runtime test artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Node dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production and test build artifacts
dist/
*/dist/
dist-ssr/
build/
*.egg-info/

# Environment files and credentials
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example

# Database files
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# Large media, video screen recordings & slides (kept deleted per project rules)
*.mp4
*.mkv
*.avi
*.mov
*.pptx
*.ppt
uploads/
*.zip
*.tar.gz

# IDE and OS metadata
.DS_Store
*/.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local runtime logs
*.log
